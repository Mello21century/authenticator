{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "http://localhost:8080/api" } },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "https://authenticator.sz4h.com/api" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_API_URL": "https://authenticator.sz4h.com/api" } }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID" },
      "android": { "track": "internal" }
    }
  }
}
