PORT=3000
MONGO_URL=mongodb://mongo:27017/authenticator
# >= 32 chars: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# exactly 32 bytes base64: openssl rand -base64 32
VAULT_MASTER_KEY=
RESEND_API_KEY=re_xxx
MAIL_FROM=Authenticator <no-reply@example.com>
APP_URL=https://auth.example.com
SIGNUP_ENABLED=true
# extra origins allowed (desktop app uses app://authenticator)
CORS_ORIGINS=app://authenticator

# reverse proxies in front of the api: Traefik + nginx (web) = 2
TRUST_PROXY_HOPS=2

# mobile force update: apps below this version must update first (empty = never)
MIN_APP_VERSION=
IOS_STORE_URL=
ANDROID_STORE_URL=
